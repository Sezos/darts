{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "darts-onoo",
          "appId": "1:392300985513:android:6008be707b7b9617a33db8",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "darts-onoo",
          "appId": "1:392300985513:ios:7f3cef795b3bfbc2a33db8",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "darts-onoo",
          "configurations": {
            "android": "1:392300985513:android:6008be707b7b9617a33db8",
            "ios": "1:392300985513:ios:7f3cef795b3bfbc2a33db8"
          }
        }
      }
    }
  },
  "firestore": {
    "location": "asia-east2",
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "DartScore",
        "supportEmail": "b4dral@gmail.com",
        "authorizedRedirectUris": [
          "https://darts-onoo.firebaseapp.com/__/auth/handler"
        ]
      }
    }
  },
  "hosting": {
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/f/**",
        "destination": "/f.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ]
  }
}
