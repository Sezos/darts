rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Every person signs in with Firebase Auth (anonymous first, optionally
// linked to Apple or Google later, which keeps the same uid).
//
// Collection: profiles
// Document ID: {uid} (the owner's Firebase Auth uid)
// Fields:
//   - name: string (required, 1-40 chars) - display name shown to friends
//   - code: string (required, matches ^[2-9A-HJ-NP-Z]{6}$, IMMUTABLE)
//       - friend code; codes/{code} must point back to this uid
//   - x01: map (optional) - x01 skill rating
//       - value: number 0-180 (3-dart average) or null (still in placement)
//       - games: int >= 0
//   - cricket: map (optional) - Cricket skill rating
//       - value: number 0-9 (marks per round) or null (still in placement)
//       - games: int >= 0
//   - createdAt: timestamp (required, == request.time on create, IMMUTABLE)
//   - updatedAt: timestamp (required, == request.time on every write)
//   No other fields. Holds no private data: any signed-in user who knows
//   the uid may get it, but nobody may list or query the collection.
//
// Collection: codes
// Document ID: {code} (the 6-character friend code)
// Fields:
//   - uid: string (required, == creator's uid, IMMUTABLE) - code owner
//   No other fields. Created in the same batch/transaction as the profile.
//   Never updated; deleted only by its owner.
//
// Subcollection: profiles/{uid}/friends
// Document ID: {friendUid}
// Fields:
//   - addedAt: timestamp (required, == request.time)
//   No other fields. Means "uid has friendUid as a friend". Adding is
//   mutual: the adder writes profiles/{me}/friends/{them} and
//   profiles/{them}/friends/{me} in one batch. Never updated. Either side
//   may delete either document. Only the list owner may read it.
//
// Subcollection: profiles/{uid}/games
// Document ID: {gameId} (client-chosen)
// Fields:
//   - json: string (required, at most 100000 chars) - serialized game
//   - playedAt: timestamp (required)
//   No other fields. Private backup: owner-only for every operation.
//
// Everything else is denied.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // The request comes from a signed-in user (anonymous counts).
    function isAuthenticated() {
      return request.auth != null;
    }

    // The signed-in user is the given uid.
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // The document's own `uid` field belongs to the signed-in user.
    function isDocOwner() {
      return isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // On create: the `uid` field, if present, is the caller's uid.
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // (No uidNotModified() helper: the only doc with a `uid` field is
    // codes/{code}, and it can never be updated at all.)

    // The written document has all of these keys.
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // The written document has no keys outside this list.
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // On update: none of these fields changed (including being removed).
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // A string within a length range.
    function isStringOfLength(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    // Friend codes: 6 chars from 2-9 and A-Z without I and O.
    function isValidFriendCode(code) {
      return code is string && code.matches('^[2-9A-HJ-NP-Z]{6}$');
    }

    function profilePath(userId) {
      return /databases/$(database)/documents/profiles/$(userId);
    }

    function codePath(code) {
      return /databases/$(database)/documents/codes/$(code);
    }

    function friendPath(userId, friendId) {
      return /databases/$(database)/documents/profiles/$(userId)/friends/$(friendId);
    }

    // ===============================================================
    // Domain Validators (used by both create and update)
    // ===============================================================

    // A skill rating map: exactly {value, games}. value is null during
    // placement, otherwise a number in [0, maxValue] (this also rejects
    // NaN and Infinity). games is a non-negative integer.
    function isValidRating(rating, maxValue) {
      return rating is map &&
        rating.keys().hasAll(['value', 'games']) &&
        rating.keys().hasOnly(['value', 'games']) &&
        (rating.value == null ||
          (rating.value is number && rating.value >= 0 && rating.value <= maxValue)) &&
        rating.games is int && rating.games >= 0;
    }

    // Full profile shape after the write. updatedAt must be the server time
    // of this request (FieldValue.serverTimestamp() on the client).
    function isValidProfile(data) {
      return hasRequiredFields(data, ['name', 'code', 'createdAt', 'updatedAt']) &&
        hasOnlyAllowedFields(data, ['name', 'code', 'x01', 'cricket', 'createdAt', 'updatedAt']) &&
        isStringOfLength(data.name, 1, 40) &&
        isValidFriendCode(data.code) &&
        (!('x01' in data) || isValidRating(data.x01, 180)) &&
        (!('cricket' in data) || isValidRating(data.cricket, 9)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    // After this batch, codes/{code} exists and points at userId.
    function codeBelongsAfter(code, userId) {
      return existsAfter(codePath(code)) &&
        getAfter(codePath(code)).data.uid == userId;
    }

    // codes/{code} document: exactly {uid}, uid is the caller.
    function isValidCodeDoc(data) {
      return hasRequiredFields(data, ['uid']) &&
        hasOnlyAllowedFields(data, ['uid']) &&
        data.uid is string &&
        uidUnchanged();
    }

    // After this batch, the caller's profile exists and uses this code.
    function profileUsesCodeAfter(code) {
      return existsAfter(profilePath(request.auth.uid)) &&
        getAfter(profilePath(request.auth.uid)).data.code == code;
    }

    // Friend document: exactly {addedAt}, set to the server time.
    function isValidFriend(data) {
      return hasRequiredFields(data, ['addedAt']) &&
        hasOnlyAllowedFields(data, ['addedAt']) &&
        data.addedAt is timestamp &&
        data.addedAt == request.time;
    }

    // Owner adds someone to their own list. The friend's profile must
    // already exist and the owner's profile must exist after this batch.
    function isOwnerAddingFriend(userId, friendId) {
      return request.auth.uid == userId &&
        exists(profilePath(friendId)) &&
        existsAfter(profilePath(userId));
    }

    // The friend adds themselves to userId's list. Only allowed when the
    // same batch also leaves profiles/{friendId}/friends/{userId} in place
    // (the reverse half of a mutual add), userId's profile exists, and
    // the caller's own profile exists after this batch.
    function isFriendAddingThemselves(userId, friendId) {
      return request.auth.uid == friendId &&
        existsAfter(friendPath(friendId, userId)) &&
        exists(profilePath(userId)) &&
        existsAfter(profilePath(friendId));
    }

    // Saved game backup: exactly {json, playedAt}.
    function isValidGame(data) {
      return hasRequiredFields(data, ['json', 'playedAt']) &&
        hasOnlyAllowedFields(data, ['json', 'playedAt']) &&
        isStringOfLength(data.json, 0, 100000) &&
        data.playedAt is timestamp;
    }

    // ===============================================================
    // profiles/{uid}
    // ===============================================================
    match /profiles/{uid} {
      // Fetch by uid only. No queries, so profiles can't be enumerated.
      allow get: if isAuthenticated();
      allow list: if false;

      // Created together with codes/{code} in one batch or transaction.
      allow create: if isOwner(uid) &&
        isValidProfile(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        codeBelongsAfter(request.resource.data.code, uid);

      // Owner edits name and ratings. code and createdAt are fixed.
      allow update: if isOwner(uid) &&
        isValidProfile(request.resource.data) &&
        areImmutableFieldsUnchanged(['code', 'createdAt']);

      allow delete: if isOwner(uid);

      // -------------------------------------------------------------
      // profiles/{uid}/friends/{friendUid}
      // -------------------------------------------------------------
      match /friends/{friendUid} {
        // Only the list owner reads their friends (get and list).
        allow read: if isOwner(uid);

        allow create: if isAuthenticated() &&
          uid != friendUid &&
          isValidFriend(request.resource.data) &&
          (isOwnerAddingFriend(uid, friendUid) ||
            isFriendAddingThemselves(uid, friendUid));

        allow update: if false;

        // Either side may unfriend.
        allow delete: if isAuthenticated() &&
          (request.auth.uid == uid || request.auth.uid == friendUid);
      }

      // -------------------------------------------------------------
      // profiles/{uid}/games/{gameId}
      // -------------------------------------------------------------
      match /games/{gameId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidGame(request.resource.data);
        allow delete: if isOwner(uid);
      }
    }

    // ===============================================================
    // codes/{code}
    // ===============================================================
    match /codes/{code} {
      // Look up a scanned code. No queries, so codes can't be listed.
      allow get: if isAuthenticated();
      allow list: if false;

      // Only claimable by the user whose profile carries this code after
      // the batch. An existing code can't be overwritten (that's an update).
      allow create: if isAuthenticated() &&
        isValidFriendCode(code) &&
        isValidCodeDoc(request.resource.data) &&
        profileUsesCodeAfter(code);

      allow update: if false;

      allow delete: if isDocOwner();
    }

    // Everything else stays denied (Firestore denies unmatched paths by
    // default; there is deliberately no catch-all allow here).
  }
}
